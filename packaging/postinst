#!/bin/sh
set -e

UI_PATCH=/usr/share/pve-qnap-plugin/ui-patch

case "$1" in
    configure)
        # Perl modules are loaded when the daemons start, so they must be restarted.
        for svc in pvedaemon pveproxy pvestatd; do
            systemctl is-active --quiet "$svc" && systemctl try-restart "$svc" || true
        done
        "$UI_PATCH" apply || echo "pve-qnap-plugin: web UI editor not installed" >&2
        ;;
    triggered)
        # pve-manager was updated and replaced pvemanagerlib.js.
        "$UI_PATCH" apply || echo "pve-qnap-plugin: web UI editor not installed" >&2
        ;;
esac

exit 0
